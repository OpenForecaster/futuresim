# HTCondor submit file for Hugging Face large-folder uploads.
# Usage:
#   1) Edit `arguments` / `environment` if needed.
#   2) Submit:
#        condor_submit_bid 15 mpi_scripts/hf_upload/hf_upload.sub

executable = /home/sgoel/forecast-sim/mpi_scripts/hf_upload/run_hf_upload.sh

# repo_id local_path
arguments = shash42/forecast-news /lustre/fast/fast/sgoel/forecasting/news/deduped_articles/data

output = /is/cluster/fast/sgoel/logs/forecasting-sim/hf_upload/$(Cluster).$(Process).out
error  = /is/cluster/fast/sgoel/logs/forecasting-sim/hf_upload/$(Cluster).$(Process).err
log    = /is/cluster/fast/sgoel/logs/forecasting-sim/hf_upload/$(Cluster).$(Process).log

request_cpus = 16
request_memory = 64GB
request_disk = 200GB
request_gpus = 0
jobprio = -985

getenv = true
environment = "HF_UPLOAD_NUM_WORKERS=8 HF_UPLOAD_INCLUDE_GLOB=**/*.parquet HF_UPLOAD_PROGRESS_SECS=60 HF_UPLOAD_STAGE_ROOT=/home/sgoel/hf_upload_staging HF_UPLOAD_VERIFY_REMOTE=1 HF_UPLOAD_DELETE_STAGE_ON_SUCCESS=1"

queue
