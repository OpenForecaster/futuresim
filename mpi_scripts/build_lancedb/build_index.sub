# HTCondor submit file for LanceDB stage 2/2:
# build FTS index (with positions by default) + optional IVF-PQ vector index.
# Run with: condor_submit_bid 25 build_index.sub

executable = /home/nchandak/forecast-sim/mpi_scripts/build_lancedb/build_index.sh

output = /home/nchandak/forecast-sim/logs/build_lancedb/index_$(Cluster).out
error = /home/nchandak/forecast-sim/logs/build_lancedb/index_$(Cluster).err
log = /home/nchandak/forecast-sim/logs/build_lancedb/index_$(Cluster).log

# FTS on very large tables is memory-heavy; keep this on high-memory nodes.
request_cpus = 8
request_memory = 256GB
request_disk = 100GB
request_gpus = 0
getenv = true

queue
