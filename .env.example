# Copy to .env and edit for your machine or cluster.
# API keys can live here too.

FSIM_REPO_DIR=/path/to/forecast-sim

FSIM_DATASET_PATH=/path/to/OpenForesight
FSIM_DATASET_CACHE=/path/to/huggingface/datasets
FSIM_OUTPUT_BASE=/path/to/current_sim
FSIM_SEARCH_DB=/path/to/news/deduped_articles/lance/Qwen3-Embedding-8B
FSIM_EMBEDDING_MODEL=/path/to/models/Qwen3-Embedding-8B
FSIM_MATCHER_MODEL=/path/to/models/qwen3-4b-it-2507
FSIM_DEFAULT_MODEL_PATH=${FSIM_MATCHER_MODEL}

FSIM_NEWS_BASE=/path/to/news
FSIM_HF_HOME=/path/to/huggingface
FSIM_SIM_LOG_BASE=${FSIM_REPO_DIR}/logs/sims
FSIM_NEWS_LOG_BASE=${FSIM_REPO_DIR}/logs/news
FSIM_SKYRL_LOG_BASE=${FSIM_REPO_DIR}/logs/skyrl
FSIM_SKYRL_OUTPUT_DIR=${FSIM_REPO_DIR}/logs/skyrl/data
FSIM_SKYRL_CKPT_BASE=${FSIM_REPO_DIR}/logs/skyrl/ckpts
FSIM_SYNTHETICQA_LOG_DIR=${FSIM_REPO_DIR}/logs/syntheticqa
FSIM_TANTIVY_INDEX_ROOT=${HOME}/forecasting/lancedb_tantivy_indices
