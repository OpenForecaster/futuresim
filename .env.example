# Copy to .env and fill in API keys or storage overrides.
# FSIM_* names are kept for compatibility with the shipped configs.

OPENROUTER_API_KEY=
OPENREWARD_API_KEY=

FSIM_DATASET_PATH=nikhilchandak/OpenForesight
FSIM_DATASET_CACHE=${FSIM_REPO_DIR}/.cache/huggingface/datasets
FSIM_OUTPUT_BASE=${FSIM_REPO_DIR}/logs/current_sim

# Download shash42/forecast-news-embeddings here if you want search enabled.
FSIM_ARTIFACT_BASE=${FSIM_REPO_DIR}/artifacts
FSIM_SEARCH_BACKEND=
FSIM_ARTICLES_BASE=${FSIM_ARTIFACT_BASE}/forecast-news
FSIM_SEARCH_DB=${FSIM_ARTIFACT_BASE}/forecast-news-embeddings
FSIM_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

FSIM_MATCHER_MODEL=deepseek/deepseek-v3.2
FSIM_DEFAULT_MODEL_PATH=${FSIM_MATCHER_MODEL}

# Optional shared matcher-cache root. split: test runs auto-use this when set.
# FSIM_SIM_MATCHER_CACHE_DIR=/path/to/sim_matcher_cache
