+# Read dates from environment variables (set by run_news_crawl.sh)
+def _parse_date_env(var_name, default=None):
+    """Parse date from environment variable in YYYY-MM-DD format."""
+    val = os.environ.get(var_name, "")
+    if val:
+        try:
+            parts = val.split("-")
+            return datetime.datetime(int(parts[0]), int(parts[1]), int(parts[2]))
+        except (ValueError, IndexError):
+            print(f"WARNING: Could not parse {var_name}={val}, using default")
+    return default
