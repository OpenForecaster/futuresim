+# Load domain filter from domains.txt
+# Load domain filter from domains.txt
+def _load_domains():
+    # Try to find domains.txt relative to this file
+    # This file is in newsplease/examples/commoncrawl.py
+    # We want to go up to data/news/domains.txt
+    # path: ../../../domains.txt
+    try:
+        current_dir = os.path.dirname(os.path.abspath(__file__))
+        domains_file = os.path.abspath(os.path.join(current_dir, '../../../domains.txt'))
+        
+        # Override with env var if set
+        if 'NEWS_DOMAINS_FILE' in os.environ:
+            domains_file = os.environ['NEWS_DOMAINS_FILE']
+            
+        domains = []
+        with open(domains_file, 'r') as f:
+            for line in f:
+                line = line.strip()
+                if line and not line.startswith('#'):
+                    domains.append(line)
+        return domains
+    except FileNotFoundError:
+        print(f"WARNING: Could not find domains.txt at {domains_file}, using no domain filter")
+        return []
+
 # hosts (if None or empty list, any host is OK)
-my_filter_valid_hosts = []  # example: ['elrancaguino.cl']
+my_filter_valid_hosts = _load_domains()  # ~130 high-quality news domains
