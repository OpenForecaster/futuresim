# Optional: shared default env for repo commands and AISA simulation jobs.
# Leave unset to use ${FSIM_REPO_DIR}/.venv, which should stay aligned with uv.lock
# so `uv run ...` works from the repo root.
# FSIM_VENV_PATH=${FSIM_REPO_DIR}/.venv-qwen35
#
# Optional: override only the embedding launcher if you still need a separate
# legacy embedding environment on AISA.
# FSIM_EMBED_VENV_PATH=${FSIM_REPO_DIR}/.venv-embed-legacy

FSIM_NEWS_BASE=/mnt/nfs/datasets_ac/news
FSIM_NEWS_JSONL_DIR=${FSIM_NEWS_BASE}/deduped_articles/jsonl
